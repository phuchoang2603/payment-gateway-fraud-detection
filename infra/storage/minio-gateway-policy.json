{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::platform-dev"
      ]
    },
    {
      "Sid": "ListGatewayPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::platform-dev"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "datasets/payment-gateway",
            "datasets/payment-gateway/*",
            "runs/payment-gateway",
            "runs/payment-gateway/*",
            "lakehouse",
            "lakehouse/*"
          ]
        }
      }
    },
    {
      "Sid": "ManageGatewayObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::platform-dev/datasets/payment-gateway/*",
        "arn:aws:s3:::platform-dev/runs/payment-gateway/*",
        "arn:aws:s3:::platform-dev/lakehouse/*"
      ]
    }
  ]
}
