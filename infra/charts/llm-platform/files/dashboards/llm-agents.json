    {
      "type": "row",
      "title": "Screening (d3-edge)",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Gateway screening decisions",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (status) (increase(agentgateway_requests_total{gateway=\"llm/agentgateway\",route=\"llm/decision\",route_rule=~\".*screen\"}[$__rate_interval]))",
          "legendFormat": "screen {{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (phase, action) (increase(agentgateway_guardrail_checks_total[$__rate_interval]))",
          "legendFormat": "guard {{phase}} {{action}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Screen calls by status (the prompt guard's webhook into the gateway's /v1/systemone screen rule) and the gateway's guard checks by phase and action; rejects there include screening refusals, masks are PII masking."
    },
    {
      "type": "timeseries",
      "title": "Screen call p95",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
