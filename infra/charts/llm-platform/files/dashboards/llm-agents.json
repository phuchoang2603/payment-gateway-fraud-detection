  "refresh": "1m",
  "editable": true,
  "panels": [
    {
      "type": "row",
      "title": "Agents",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "bargauge",
      "title": "Calls per agent (A2A, in range)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (route) (increase(agentgateway_requests_total{gateway=\"llm/agentgateway\",route=~\"llm/a2a-.*\",method=\"POST\"}[$__range]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "description": "A2A message calls through the gateway, per agent route; agent cards (GET) are not counted."
    },
    {
      "type": "timeseries",
      "title": "A2A calls per agent",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
