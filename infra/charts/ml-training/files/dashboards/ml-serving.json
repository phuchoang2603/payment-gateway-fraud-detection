{
  "uid": "ml-serving",
  "title": "ML model serving",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "ml",
    "serving"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Triton request rate",
      "description": "Requests the payment-risk model answered or failed, from Triton's own metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nv_inference_request_success{model=\"payment-risk\"}[5m]))",
          "legendFormat": "success"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nv_inference_request_failure{model=\"payment-risk\"}[5m]))",
          "legendFormat": "failure"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Triton time per request",
      "description": "Mean time a request waits in the queue and runs on the GPU. The autoscaler adds a replica when the queue time stays above its 5 ms target.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nv_inference_queue_duration_us{model=\"payment-risk\"}[5m])) / clamp_min(sum(rate(nv_inference_request_success{model=\"payment-risk\"}[5m])), 1) / 1000",
          "legendFormat": "queue"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nv_inference_compute_infer_duration_us{model=\"payment-risk\"}[5m])) / clamp_min(sum(rate(nv_inference_request_success{model=\"payment-risk\"}[5m])), 1) / 1000",
          "legendFormat": "compute"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Predictor replicas",
      "description": "Replicas of the payment-risk predictor Deployment. KEDA scales it between the chart's minimum and maximum.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas{namespace=\"ml\",deployment=\"payment-risk-predictor\"}",
          "legendFormat": "desired"
        },
        {
          "refId": "B",
          "expr": "kube_deployment_status_replicas_available{namespace=\"ml\",deployment=\"payment-risk-predictor\"}",
          "legendFormat": "available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU utilization",
      "description": "Shared by Triton and the training and scoring jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (gpu, Hostname) (DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "{{Hostname}} gpu {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Model calls from the fraud service",
      "description": "Calls by outcome and whether the score was enforced, from the fraud service's OTLP counter. No data means no observed assessments.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status, enforced) (rate({__name__=\"fraud.model.calls\",\"deployment.environment\"=\"$environment\",\"k8s.namespace.name\"=\"payment-gateway\"}[5m]))",
          "legendFormat": "{{status}} enforced={{enforced}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "dev,prod",
        "current": {
          "text": "dev",
          "value": "dev"
        }
      }
    ]
  }
}
