{
  "uid": "payments-overview",
  "title": "Payments overview",
  "tags": [
    "payments",
    "marts"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-180d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Daily attempts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(day) AS time, sum(attempts) AS attempts\nFROM marts.fact_merchant_day WHERE $__dateFilter(day) GROUP BY day ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Approval and risk-decline rate",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(day) AS time,\n  sum(succeeded) / nullIf(sum(decided), 0) AS approval_rate,\n  sum(risk_declined) / nullIf(sum(decided), 0) AS risk_decline_rate\nFROM marts.fact_merchant_day WHERE $__dateFilter(day) GROUP BY day ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {},
      "description": "Denominator: decided attempts (succeeded or declined)."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Attempted and succeeded amount (minor units)",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(day) AS time,\n  sum(amount_attempted_minor) AS attempted, sum(amount_succeeded_minor) AS succeeded\nFROM marts.fact_merchant_day WHERE $__dateFilter(day) GROUP BY day ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top 10 merchants by attempts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT merchant_id, sum(attempts) AS attempts,\n  sum(succeeded) / nullIf(sum(decided), 0) AS approval_rate\nFROM marts.fact_merchant_day WHERE $__dateFilter(day)\nGROUP BY merchant_id ORDER BY attempts DESC, merchant_id LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Hot-merchant share of attempts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT max(attempts) / sum(attempts) AS hot_merchant_share\nFROM (SELECT merchant_id, sum(attempts) AS attempts FROM marts.fact_merchant_day WHERE $__dateFilter(day) GROUP BY merchant_id)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Build window",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT window_start, window_end, mode, built_at FROM marts.build_info"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "The marts keep a rolling window; days before window_start are not zero, they are outside it."
    }
  ]
}
