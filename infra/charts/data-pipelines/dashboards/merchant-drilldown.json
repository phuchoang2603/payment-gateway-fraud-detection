{
  "uid": "merchant-drilldown",
  "title": "Merchant drill-down",
  "tags": [
    "payments",
    "marts"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-180d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "merchant",
        "label": "Merchant",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse-marts"
        },
        "query": {
          "refId": "merchant",
          "editorType": "sql",
          "format": 1,
          "rawSql": "SELECT merchant_id FROM marts.fact_merchant_day GROUP BY merchant_id ORDER BY sum(attempts) DESC, merchant_id LIMIT 200"
        },
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Daily attempts and approval rate",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toDateTime(day) AS time, attempts, approval_rate\nFROM marts.fact_merchant_day WHERE $__dateFilter(day) AND merchant_id = '${merchant}' ORDER BY day"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outcome mix",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 0,
          "rawSql": "SELECT toStartOfDay(started_at) AS time, outcome, count() AS attempts\nFROM marts.fact_payment_attempt WHERE $__timeFilter(started_at) AND merchant_id = '${merchant}'\nGROUP BY time, outcome ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "table",
      "title": "Recent attempts",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-marts"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-marts"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT started_at, payment_id, attempt_id, customer_id, amount_minor, outcome, risk_score\nFROM marts.fact_payment_attempt WHERE $__timeFilter(started_at) AND merchant_id = '${merchant}'\nORDER BY started_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
