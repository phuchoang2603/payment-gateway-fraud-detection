  "defaults": {
    "attempt": {
      "integration_id": "i",
      "customer_id": "c",
      "payment_method_fingerprint": "card",
      "merchant_id": "m",
      "device_fingerprint": "d",
      "amount_minor": 100,
      "currency": "USD",
      "outcome": "pending",
      "outcome_at": null,
      "decline_source": null
    },
    "history": [
      {
        "customer_id": "h",
        "payment_method_fingerprint": "h-card",
        "started_at": "2025-06-01T12:00:00+00:00"
      }
    ],
    "cutoff": "2026-01-01T06:00:00+00:00",
    "view": "customer",
    "entity": {
      "integration_id": "i",
      "customer_id": "c"
    }
  },
  "cases": [
