        },
        {
          "event_timestamp": "2025-09-09T00:00:00+00:00",
          "values": {
            "attempt_count_7d": 0,
            "amount_sum_minor_7d": 0,
            "distinct_merchant_count_7d": 0,
            "attempt_count_30d": 1
          }
        },
        {
          "event_timestamp": "2025-10-02T00:00:00+00:00",
          "values": {
            "attempt_count_7d": 0,
            "attempt_count_30d": 0,
            "distinct_merchant_count_30d": 0
          }
